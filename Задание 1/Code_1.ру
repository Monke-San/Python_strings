text = input("Введите текс: ")

i = 0
words = []

while i < len(text):
    while i < len(text) and text[i] == " ":
        i += 1
        
    word = ""

    while i < len(text) and text[i] != " ":
        word += text[i]
        i += 1

    if word:
        words.append(word)

mirrored = ' '.join(words[::-1])

reversed = []

for w in words[::-1]:
    reversed.append(w[::-1])

final = ' '.join(reversed)

print("Отзеркалено: ", mirrored)
print("Обратный порядок: ", final)